# Comma-separated extra calendar days on which XTB should apply its 0.8% fee.
# Romanian fixed and Orthodox Easter holidays are included in code.
XTB_HOLIDAYS=2026-12-24

# Optional overrides for running the API outside Docker Compose.
# DATABASE_URL=postgres://undeschimb:undeschimb@localhost:5432/undeschimb?sslmode=disable
# REFRESH_EVERY=15m
# HTTP_TIMEOUT=12s

# Frontend server: full URL of the existing API, including /api/v1.
# Docker Compose configures this automatically. Render must set this on the web service.
# API_URL=https://your-api-service.onrender.com/api/v1
# PORT=5173
