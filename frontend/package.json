{
  "name": "undeschimb-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "test:chart": "node --test scripts/history-chart.test.mjs",
    "seo:check": "node scripts/check-seo.mjs",
    "build:client": "vite build",
    "build:server": "vite build --ssr src/entry-server.tsx --outDir dist-ssr",
    "prerender": "node scripts/prerender.mjs",
    "analytics:inject": "node scripts/inject-analytics.mjs",
    "build": "npm run typecheck && npm run seo:check && npm run build:client && npm run build:server && npm run prerender && npm run analytics:inject",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "22.10.5",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "4.3.4",
    "typescript": "5.7.3",
    "vite": "5.4.21"
  }
}
